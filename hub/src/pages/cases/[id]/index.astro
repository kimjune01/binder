---
import Layout from "../../../layouts/Layout.astro";
import InlineText from "../../../components/InlineText.astro";
import { loadCases, type PublicCase } from "../../../lib/cases";

export async function getStaticPaths() {
  return (await loadCases()).map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props { item: PublicCase }
const { item } = Astro.props;
const artifactById = new Map(item.artifacts.map((artifact) => [artifact.id, artifact]));
---

<Layout title={`${item.title} — Binder`} description={item.summary}>
  <nav><a href="/">← All cases</a><a href={`/cases/${item.id}/case.json`}>JSON</a></nav>

  <header class="hero case-hero">
    <p class="eyebrow">{item.ecosystem} · {item.class.replaceAll("-", " / ")}</p>
    <h1>{item.title}</h1>
    <p class="lede">{item.summary}</p>
  </header>

  <main id="main-content" class="case-body case-study">
    <div class="case-tabs" role="tablist" aria-label="Case views">
      <a role="tab" id="tab-current" aria-controls="current" aria-selected="true" href="#current">Current</a>
      <a role="tab" id="tab-chronology" aria-controls="chronology" aria-selected="false" href="#chronology">Chronology</a>
      <a role="tab" id="tab-actions" aria-controls="actions" aria-selected="false" href="#actions">Next actions <span>{item.recommendations.length}</span></a>
    </div>

    <div id="current" class="tab-panel" role="tabpanel" aria-labelledby="tab-current">
      <section>
        <h2>Situation</h2>
        <p><InlineText text={item.case_study.situation} /></p>
      </section>
      <section>
        <h2>Response</h2>
        <p><InlineText text={item.case_study.turning_point} /></p>
      </section>
      <aside class="claim-box" aria-labelledby="claim-heading">
        <p class="section-label">Claim under review</p>
        <h2 id="claim-heading">{item.decision.question}</h2>
        <p><InlineText text={item.claim} /></p>
      </aside>
      <section class="verdict">
        <h2>Assessment</h2>
        <p class="verdict-text">{item.decision.expected}</p>
        <p><InlineText text={item.case_study.lesson} /></p>
      </section>
      <section>
        <h2>Open questions</h2>
        <p>{item.evidence_boundary}</p>
        <ul class="unknowns">{item.missing_edges.map((gap) => <li>{gap}</li>)}</ul>
      </section>
    </div>

    <div id="chronology" class="tab-panel" role="tabpanel" aria-labelledby="tab-chronology">
      <section>
        <p class="section-label">The public record</p>
        <h2>How the evidence connects</h2>
        <ol class="evidence-trail">
          {item.edges.map((edge, index) => (
            <li>
              <span class="trail-number">{index + 1}</span>
              <div>
                <p><InlineText text={`${edge.from} ${edge.relation} ${edge.to}.`} /> <mark class={edge.status}>{edge.status}</mark></p>
                {edge.citations.length > 0 && (
                  <small>Sources: {edge.citations.map((id, sourceIndex) => {
                    const artifact = artifactById.get(id);
                    return <><a href={artifact?.url} target="_blank" rel="noopener">{artifact?.title ?? id}</a>{sourceIndex < edge.citations.length - 1 ? ", " : ""}</>;
                  })}</small>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
      <section>
        <p class="section-label">Go to the record</p>
        <h2>Inspect it yourself</h2>
        <details open>
          <summary>Canonical sources</summary>
          <ul class="artifacts">
            {item.artifacts.map((artifact) => (
              <li><span>{artifact.kind}</span><a href={artifact.url} target="_blank" rel="noopener">{artifact.title}<span class="visually-hidden"> (opens in a new tab)</span></a>{artifact.revision && <code>{artifact.revision}</code>}</li>
            ))}
          </ul>
        </details>
        <details>
          <summary>Research and validation files</summary>
          <div class="packet-grid">
            <a href={`/cases/${item.id}/control.md`}><strong>Control</strong><span>Raw-source review task</span></a>
            <a href={`/cases/${item.id}/curated.md`}><strong>Curated</strong><span>Joined case view</span></a>
            <a href={`/cases/${item.id}/questions.md`}><strong>Questions</strong><span>Fixed decision prompts</span></a>
            <a href={`/cases/${item.id}/answer-key.md`}><strong>Answer key</strong><span>Boundary and expected decision</span></a>
          </div>
        </details>
      </section>
    </div>

    <div id="actions" class="tab-panel" role="tabpanel" aria-labelledby="tab-actions">
      <section>
        <p class="section-label">Policy-relative recommendations</p>
        <h2>What would strengthen the current claim</h2>
        <ol class="recommendations">
          {item.recommendations.map((recommendation, index) => (
            <li><span>{index + 1}</span><div><h3><InlineText text={recommendation.action} /></h3><p>{recommendation.because}</p><a class="recommendation-guide" href={`/actions/${recommendation.guide}/`}>How to do this →</a></div></li>
          ))}
        </ol>
        <p class="form-note">These actions are derived from the visible gaps. They are recommendations, not facts or automatic requirements.</p>
        <p><a class="packet-button secondary-button" href="/method/">Learn how Binder derives these actions →</a></p>
      </section>
      <section>
        <p class="section-label">Test the projection</p>
        <h2>Reach your own decision</h2>
        <p>Review a randomly assigned evidence packet before seeing Binder's consolidated answer.</p>
        <p><a class="packet-button" href={`/validate/${item.id}/`}>Try the blinded review task →</a></p>
      </section>
    </div>
  </main>

  <script>
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[role="tab"]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const validHashes = new Set(panels.map((panel) => `#${panel.id}`));

    function selectTab(hash: string, focus = false) {
      const selectedHash = validHashes.has(hash) ? hash : "#current";
      tabs.forEach((tab) => {
        const selected = tab.hash === selectedHash;
        tab.setAttribute("aria-selected", String(selected));
        tab.setAttribute("tabindex", selected ? "0" : "-1");
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = `#${panel.id}` !== selectedHash; });
    }

    document.documentElement.classList.add("tabs-ready");
    selectTab(window.location.hash);
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab.hash));
      tab.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const delta = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(index + delta + tabs.length) % tabs.length];
        history.replaceState(null, "", next.hash);
        selectTab(next.hash, true);
      });
    });
    window.addEventListener("hashchange", () => selectTab(window.location.hash));
  </script>
</Layout>
