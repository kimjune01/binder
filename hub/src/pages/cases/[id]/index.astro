---
import Layout from "../../../layouts/Layout.astro";
import InlineText from "../../../components/InlineText.astro";
import { loadCases, type PublicCase } from "../../../lib/cases";

export async function getStaticPaths() {
  return (await loadCases()).map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props { item: PublicCase }
const { item } = Astro.props;
const artifactById = new Map(item.artifacts.map((artifact) => [artifact.id, artifact]));
---

<Layout title={`${item.title} — Binder`} description={item.summary}>
  <nav><a href="/">← All cases</a><a href={`/cases/${item.id}/case.json`}>JSON</a></nav>

  <header class="hero case-hero">
    <p class="eyebrow">{item.ecosystem} · {item.class.replaceAll("-", " / ")}</p>
    <h1>{item.title}</h1>
    <p class="lede">{item.summary}</p>
  </header>

  <main id="main-content" class="case-body case-study">
    <section>
      <p class="section-label">The situation</p>
      <h2>What happened</h2>
      <p><InlineText text={item.case_study.situation} /></p>
    </section>

    <section>
      <p class="section-label">The turning point</p>
      <h2>What changed</h2>
      <p><InlineText text={item.case_study.turning_point} /></p>
    </section>

    <aside class="claim-box" aria-labelledby="claim-heading">
      <p class="section-label">Claim under review</p>
      <h2 id="claim-heading">{item.decision.question}</h2>
      <p><InlineText text={item.claim} /></p>
    </aside>

    <section>
      <p class="section-label">The public record</p>
      <h2>How the evidence connects</h2>
      <ol class="evidence-trail">
        {item.edges.map((edge, index) => (
          <li>
            <span class="trail-number">{index + 1}</span>
            <div>
              <p><InlineText text={`${edge.from} ${edge.relation} ${edge.to}.`} /> <mark class={edge.status}>{edge.status}</mark></p>
            {edge.citations.length > 0 && (
              <small>Sources: {edge.citations.map((id, index) => {
                const artifact = artifactById.get(id);
                return <><a href={artifact?.url} target="_blank" rel="noopener">{artifact?.title ?? id}</a>{index < edge.citations.length - 1 ? ", " : ""}</>;
              })}</small>
            )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="verdict">
      <p class="section-label">The decision</p>
      <h2>What the evidence warrants</h2>
      <p class="verdict-text">{item.decision.expected}</p>
      <p><InlineText text={item.case_study.lesson} /></p>
    </section>

    <section>
      <p class="section-label">The boundary</p>
      <h2>What remains unknown</h2>
      <p>{item.evidence_boundary}</p>
      <ul class="unknowns">{item.missing_edges.map((gap) => <li>{gap}</li>)}</ul>
    </section>

    <section>
      <p class="section-label">Go to the record</p>
      <h2>Inspect it yourself</h2>
      <details>
        <summary>Canonical sources</summary>
        <ul class="artifacts">
          {item.artifacts.map((artifact) => (
            <li><span>{artifact.kind}</span><a href={artifact.url} target="_blank" rel="noopener">{artifact.title}<span class="visually-hidden"> (opens in a new tab)</span></a>{artifact.revision && <code>{artifact.revision}</code>}</li>
          ))}
        </ul>
      </details>
      <details>
        <summary>Research and validation files</summary>
        <div class="packet-grid">
          <a href={`/cases/${item.id}/control.md`}><strong>Control</strong><span>Raw-source review task</span></a>
          <a href={`/cases/${item.id}/curated.md`}><strong>Curated</strong><span>Joined case view</span></a>
          <a href={`/cases/${item.id}/questions.md`}><strong>Questions</strong><span>Fixed decision prompts</span></a>
          <a href={`/cases/${item.id}/answer-key.md`}><strong>Answer key</strong><span>Boundary and expected decision</span></a>
        </div>
      </details>
      <p><a class="packet-button" href={`/validate/${item.id}/`}>Try the blinded review task →</a></p>
    </section>
  </main>
</Layout>
